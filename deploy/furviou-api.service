[Unit]
Description=Furviou API (Express + BullMQ)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/furviou/apps/api
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/opt/furviou/apps/api/.env
ExecStart=/usr/bin/node /opt/furviou/apps/api/node_modules/tsx/dist/cli.mjs /opt/furviou/apps/api/server.ts
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
