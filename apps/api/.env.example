# Copy this file:
#   cp apps/api/.env.example apps/api/.env
#
# Then fill in the values. Never commit apps/api/.env.

NODE_ENV=development
PORT=4000

# Browser origin allowed by CORS. Must match the Next.js app.
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas (or local Mongo). Replace user, password, and cluster.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/furviou
MONGO_URI=

# Random string used to sign login cookies/tokens. Generate one:
#   openssl rand -base64 32
JWT_SECRET=

# --- Google login (Sign in with Google) ---
# OAuth client type: Web application
# Authorized JavaScript origins: http://localhost:3000
# This Client ID must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env.local
GOOGLE_CLIENT_ID=

# --- Gmail mailbox (send + read replies) ---
# Use a second Web application client, or the same one if you prefer.
# Enable Gmail API on the Google Cloud project.
# Authorized redirect URI must match this value exactly:
#   http://localhost:4000/api/auth/gmail/callback
GOOGLE_MAILBOX_CLIENT_ID=
GOOGLE_MAILBOX_CLIENT_SECRET=
GOOGLE_MAILBOX_REDIRECT_URI=http://localhost:4000/api/auth/gmail/callback

# How often the in-process sender looks for due emails (milliseconds).
SEND_INTERVAL_MS=20000
